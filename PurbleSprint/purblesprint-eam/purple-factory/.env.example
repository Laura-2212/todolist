# Credenciais Zoom Server-to-Server OAuth (Marketplace Zoom)
ZOOM_ACCOUNT_ID=seu_account_id_aqui
ZOOM_CLIENT_ID=seu_client_id_aqui
ZOOM_CLIENT_SECRET=seu_client_secret_aqui

# Conta inicial do painel administrativo: configure antes do primeiro acesso
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=defina-uma-senha-forte

# Referência do Projeto Google Stitch
STITCH_PROJECT_ID=1633125014481592218
STITCH_API_KEY=

# Google Antigravity SDK usa autenticação Gemini API
GEMINI_API_KEY=

ANTIGRAVITY_MODEL=gemini-3.8-flash
